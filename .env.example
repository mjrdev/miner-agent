# Copy to .env to override the development defaults (.env is not versioned).
# Every variable is optional for local development.

# --- API ---
# Environment name, shown in logs.
APP_ENV=development
# Port the API listens on, inside the container and on the host.
HTTP_PORT=8080
# debug, info, warn or error.
LOG_LEVEL=info
# Maximum time to wait for in-flight requests on shutdown (Go duration).
SHUTDOWN_TIMEOUT=10s
# Connection string. Defaults to the compose postgres service built from the
# POSTGRES_* values below; set it only to point at another database.
# DATABASE_URL=postgres://miner:miner@postgres:5432/miner?sslmode=disable

# --- PostgreSQL (development credentials only) ---
POSTGRES_USER=miner
POSTGRES_PASSWORD=miner
POSTGRES_DB=miner
# Host port mapped to the database (5433 avoids clashing with a local Postgres on 5432).
POSTGRES_PORT=5433

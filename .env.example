# Copy to .env to override the development defaults (.env is not versioned).
# Every variable is optional for local development.

# --- API ---
# Environment name, shown in logs.
APP_ENV=development
# Port the API listens on, inside the container and on the host.
HTTP_PORT=8080
# debug, info, warn or error.
LOG_LEVEL=info
# Maximum time to wait for in-flight requests on shutdown (Go duration).
SHUTDOWN_TIMEOUT=10s
# Connection string. Defaults to the compose postgres service built from the
# POSTGRES_* values below; set it only to point at another database.
# DATABASE_URL=postgres://miner:miner@postgres:5432/miner?sslmode=disable
# AMQP connection string. Defaults to the compose rabbitmq service built from
# the RABBITMQ_DEFAULT_* values below; set it only to point at another broker.
# RABBITMQ_URL=amqp://miner:miner@rabbitmq:5672/
# Token expected in the X-Webhook-Token header of POST /webhooks/local.
# Empty makes the local webhook reject every request.
LOCAL_WEBHOOK_TOKEN=local-dev-token

# --- PostgreSQL (development credentials only) ---
POSTGRES_USER=miner
POSTGRES_PASSWORD=miner
POSTGRES_DB=miner
# Host port mapped to the database (5433 avoids clashing with a local Postgres on 5432).
POSTGRES_PORT=5433

# --- RabbitMQ (development credentials only) ---
RABBITMQ_DEFAULT_USER=miner
RABBITMQ_DEFAULT_PASS=miner
# Host ports for AMQP and the management UI (http://localhost:15672).
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Worker (runs) ---
# Read only by the worker service; the api never receives these variables.
# Agent credentials, in order of priority: the Claude subscription token
# (generate it with `claude setup-token`) and the pay-per-use API key. Without
# either, the runs fail with "no agent credentials configured".
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Token used only to clone private repositories (never stored or logged).
GIT_TOKEN=
# Runs executed at the same time, and the time limit of each run.
MAX_CONCURRENT_RUNS=1
RUN_TIMEOUT=60m
# Image the runs execute in (make agent-image builds it).
AGENT_IMAGE=miner-agent:default
# Host path of ./runs; empty discovers it from the worker container's mounts.
RUNS_HOST_DIR=
